# -------------------------------------------------------------
# WaterTrack Backend - Environment Configuration Template
# Copy this file to .env or set environment variables in Render
# -------------------------------------------------------------

# Application
PROJECT_NAME="WaterTrack API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite or PostgreSQL)
# SQLite:
DATABASE_URL="sqlite:///./watertrack.db"
# PostgreSQL (Render PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS="*"

# External Weather Service (Open-Meteo)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_TIMEOUT_SECONDS=5.0
DEFAULT_ROOM_TEMP_CELSIUS=22.0
